{
  "manifest_version": 3,
  "name": "CoderSnap Network Recorder",
  "version": "1.0.4",
  "description": "Records network requests during Amazon shift application",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://hiring.amazon.ca/*",
    "https://hiring.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hiring.amazon.ca/*",
        "https://hiring.amazon.com/*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
