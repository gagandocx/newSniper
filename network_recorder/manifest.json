{
  "manifest_version": 3,
  "name": "CoderSnap Network Recorder",
  "version": "1.0.1",
  "description": "Records network requests during Amazon shift application",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://hiring.amazon.ca/*",
    "https://hiring.amazon.com/*",
    "https://*.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "recorder_bg.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hiring.amazon.ca/*",
        "https://hiring.amazon.com/*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
