{
   "action": {
      "default_popup": "index.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [
            "notif_block.js"
         ],
         "matches": [
            "https://hiring.amazon.ca/*",
            "https://hiring.amazon.com/*",
            "*://auth.hiring.amazon.com/*",
            "*://auth.hiring.amazon.ca/*"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "css": [
            "/css/sweetalert.css",
            "css/swal_theme.css"
         ],
         "js": [
            "sweetalert.js",
            "fetch.js",
            "Createapp.js"
         ],
         "matches": [
            "https://hiring.amazon.ca/*",
            "https://hiring.amazon.com/*",
            "*://auth.hiring.amazon.com/*",
            "*://auth.hiring.amazon.ca/*"
         ],
         "run_at": "document_idle"
      },
      {
         "css": [
            "css/swal_theme.css"
         ],
         "js": [
            "sweetalert.js",
            "auth.js"
         ],
         "matches": [
            "*://auth.hiring.amazon.com/*",
            "*://auth.hiring.amazon.ca/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "description": "This Extension Books Amazon Warehouse Shift Automatically",
   "externally_connectable": {
      "matches": [
         "https://hiring.amazon.ca/*",
         "https://hiring.amazon.com/*",
         "*://auth.hiring.amazon.com/*",
         "*://auth.hiring.amazon.ca/*"
      ]
   },
   "host_permissions": [
      "https://hiring.amazon.ca/*",
      "https://hiring.amazon.com/*",
      "*://auth.hiring.amazon.com/*",
      "*://auth.hiring.amazon.ca/*",
      "https://mail.google.com/*",
      "https://api.groq.com/*",
      "https://api.telegram.org/*",
      "https://*.captcha-sdk.awswaf.com/*",
      "https://*.awswaf.com/*",
      "<all_urls>"
   ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
   },
   "incognito": "spanning",
   "key": "",
   "manifest_version": 3,
   "name": "CoderSnap \u2014 Amazon Warehouse Job Hunter",
   "permissions": [
      "tabs",
      "storage",
      "activeTab",
      "declarativeContent",
      "scripting",
      "notifications",
      "debugger"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "8.7.9.1",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "images/popup.png",
            "alert.wav",
            "images/icon128.png",
            "css/swal_theme.css"
         ]
      }
   ]
}